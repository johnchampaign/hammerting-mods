build/
mods/*/build/
mods/*/build_rules.ninja
mods/_probe/
# Python caches
__pycache__/
*.pyc
# Local development notes (machine paths, session instructions)
CLAUDE.md
.claude/
# boot.exe --help output
re/boot_help.txt
